<Window x:Class="StudyCheckin.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自律台 - 学习打卡"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="318" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1C2B33">
            <Grid Margin="22,24,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="自律台" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="STUDY LOG" Foreground="#8FBAB4" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="计划日期" Foreground="#8FA0A7" FontSize="12" />
                    <TextBlock x:Name="SidebarDateText" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock x:Name="SidebarWeekdayText" Foreground="#B9C5C9" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="Auto" Foreground="White"
                            BorderBrush="#45575F" Content="&#xE76B;" ToolTip="前一天" Click="PreviousDay_Click" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="Auto" Foreground="White"
                            BorderBrush="#45575F" Content="&#xE76C;" ToolTip="后一天" Click="NextDay_Click" />
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,28,0,0">
                    <TextBlock Text="阶段" Foreground="#8FA0A7" FontSize="12" />
                    <TextBlock x:Name="PhaseText" Foreground="#E7C277" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border BorderBrush="#40525A" BorderThickness="0,1,0,0" Margin="0,22,0,18" />
                    <TextBlock Text="今日课程" Foreground="#8FA0A7" FontSize="12" />
                    <TextBlock x:Name="CourseText" Foreground="#E7ECEE" FontSize="13" LineHeight="21"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="5">
                    <TextBlock x:Name="ModeText" Text="LOCAL MOCK" Foreground="#8FBAB4" FontSize="11" />
                    <TextBlock x:Name="DataPathText" Foreground="#71858E" FontSize="10" TextTrimming="CharacterEllipsis"
                               ToolTip="本地数据目录" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="32,22,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="今日任务" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="HeaderSummaryText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="立即同步"
                        Click="Sync_Click" VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,28,28">
                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16">
                                <Grid Opacity="{Binding Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" IsEnabled="{Binding CanInteract}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" Tag="{Binding Id}"
                                              Click="TaskCheck_Click" ToolTip="完成任务" />
                                    <Border Grid.Column="1" Width="3" Background="{Binding CategoryBrush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="2" Margin="12,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryBrush}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding TimerDetail}" Foreground="#7A5A1F" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="42" Text="{Binding ActualMinutes}" TextAlignment="Center" Tag="{Binding Id}"
                                                 IsEnabled="{Binding CanInteract}" LostFocus="Minutes_LostFocus" />
                                        <TextBlock Text="分" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource CommandButton}" Tag="{Binding Id}"
                                            IsEnabled="{Binding CanStart}" Click="TimerButton_Click" ToolTip="开始或停止计时">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding TimerIcon}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding TimerAction}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="#F4F6F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,26,26,24">
                    <TextBlock Text="今日进度" FontSize="16" FontWeight="Bold" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource TealBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProgressPercentText" Grid.Column="1" FontSize="22" FontWeight="Bold" />
                    </Grid>
                    <ProgressBar x:Name="DailyProgress" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0"
                                 Foreground="{StaticResource TealBrush}" Background="#D9E2DF" BorderThickness="0" />
                    <TextBlock x:Name="HoursText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0" />

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,20" />
                    <TextBlock Text="当日复盘" FontSize="16" FontWeight="Bold" />
                    <TextBox x:Name="RecapBox" Height="112" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" />
                    <Button Style="{StaticResource CommandButton}" Content="保存并同步" Margin="0,10,0,0" Click="SaveRecap_Click" />

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,20" />
                    <TextBlock Text="同步与 Excel" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="SyncStateText" Text="尚未同步" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                    <TextBlock x:Name="PendingText" Foreground="#B34A3C" FontSize="12" Margin="0,4,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExcelPathBox" IsReadOnly="True" TextTrimming="CharacterEllipsis" ToolTip="规划 Excel 路径" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="选择 Excel"
                                Margin="6,0,0,0" Click="BrowseExcel_Click" />
                    </Grid>
                    <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动运行" Margin="0,14,0,0"
                              Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" />

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,18" />
                    <TextBlock Text="提醒时间" FontSize="16" FontWeight="Bold" />
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <TextBlock Text="晨间计划" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="07:30" HorizontalAlignment="Right" />
                        <TextBlock Text="开始提醒" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                        <TextBlock Text="19:00" HorizontalAlignment="Right" Margin="0,7,0,0" />
                        <TextBlock Text="未完成提醒" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                        <TextBlock Text="22:30" HorizontalAlignment="Right" Margin="0,7,0,0" />
                        <TextBlock Text="周复盘" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                        <TextBlock Text="周日 21:30" HorizontalAlignment="Right" Margin="0,7,0,0" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

